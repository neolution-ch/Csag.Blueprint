{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Blueprint": {
    "Security": {
      "CorsPolicies": {
        "DefaultPolicy": {
          "AllowCredentials": true,
          "AllowedHeaders": null,
          "AllowedMethods": "GET;POST;PUT;DELETE;OPTIONS",
          "AllowedOrigins": "http://localhost",
          "ExposedHeaders": "X-Correlation-ID",
          "PreflightMaxAgeSeconds": 3600
        }
      },
      "DefaultCorsPolicy": "DefaultPolicy",
      "HttpsRedirect": {
        "Enabled": true,
        "HttpsPort": null,
        "RedirectStatusCode": 308
      },
      "Jwt": {
        "Audience": "csag-blueprint-testhost",
        "ExpirationHours": 1,
        "Issuer": "csag-blueprint-testhost",
        "SigningKey": "TestHostSigningKeyThatIsAtLeast32CharactersLong!"
      },
      "Mfa": {
        "Enabled": false,
        "Required": false,
        "BypassExternalProviders": [],
        "Issuer": "CSAG Blueprint TestHost",
        "RecoveryCodeCount": 10
      },
      "OAuth": {
        "AutoCreateUsers": false,
        "FrontendBaseUrl": null,
        "Providers": {}
      },
      "PasswordResetSettings": {
        "TokenLifetimeMinutes": 60
      },
      "PasswordSettings": {
        "RequireDigit": true,
        "RequiredLength": 8,
        "RequiredUniqueChars": 1,
        "RequireLowercase": true,
        "RequireNonAlphanumeric": true,
        "RequireUppercase": true
      },
      "RequestLimits": {
        "MaxRequestBodySizeMegabytes": 10,
        "MultipartBodyLengthLimitMegabytes": 10
      },
      "SecurityHeaders": {
        "EnableHsts": true,
        "EnableSecurityHeaders": true,
        "RemoveServerIdentityHeaders": true
      },
      "ServiceAccountLockout": {
        "MaxFailedAccessAttempts": 5,
        "LockoutDurationMinutes": 5
      },
      "Swagger": {
        "Enabled": false
      },
      "Csrf": {
        "Enabled": true,
        "HeaderName": "X-CSRF-TOKEN",
        "CookieName": ".AspNetCore.Antiforgery",
        "RequestTokenCookieName": "XSRF-TOKEN"
      },
      "CookieSecurePolicy": "Always",
      "SessionExpirationHours": 168
    },
    "Cache": {
      "Provider": "SqlServer"
    },
    "Database": {
      "ApplyMigrationsAutomaticallyDuringStartup": false
    },
    "FeatureFlags": {
      "EnableConfigurationExample": false,
      "EnableSimulateError": false
    },
    "Localization": {
      "DefaultLanguage": "en",
      "SupportedLanguages": ["en", "de"],
      "TranslationCacheL1ExpirationMinutes": 2
    },
    "Frontend": {
      "BaseUrl": null
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=CsagBlueprintTestHost;Integrated Security=true;TrustServerCertificate=true;"
  }
}
